<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="trackerRoot" prefHeight="600.0" prefWidth="900.0" styleClass="tracker-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.neumont.Pwest.finalfinal.TrackerController">

    <!-- ===== TOP: title / view switch ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
            <padding><Insets bottom="10" left="15" right="15" top="10" /></padding>
            <Label styleClass="app-title" text="Pokédex Tracker" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="teamBuilderButton" mnemonicParsing="false" onAction="#onSwitchToTeamBuilder" styleClass="nav-button" text="Team Builder -&gt;" />
        </HBox>
    </top>

    <!-- ===== CENTER: search + counter list ===== -->
    <center>
        <VBox spacing="10.0" styleClass="tracker-center">
            <padding><Insets bottom="10" left="15" right="15" top="10" /></padding>

            <!-- Search row -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="speciesSearchField" promptText="Pokémon Species" HBox.hgrow="ALWAYS" />
                <Button fx:id="searchButton" mnemonicParsing="false" onAction="#onSearch" text="Search" />
                <Button fx:id="addCounterButton" mnemonicParsing="false" text="+ Add" />
            </HBox>

            <Separator />

            <!-- Gen counter list -->
            <ScrollPane fx:id="counterScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="counterListContainer" spacing="6.0" styleClass="counter-list">
                        <!--
                            Rows get injected here at runtime by the controller, one per
                            generation/species being tracked. Suggested row structure to
                            build programmatically (e.g. a buildCounterRow(Pokemon mon)
                            helper method that returns an HBox):

                                HBox row
                                  Label   speciesNameLabel   ("Pokémon->GetName()")
                                  Region  spacer             (HBox.hgrow = ALWAYS)
                                  Label   counterValueLabel  ("#: num")
                                  Button  incrementButton    ("num++")

                            This keeps the FXML simple while the actual list is fully
                            data-driven from your backend/model.
                        -->
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ===== RIGHT: Prof.Bug AI panel ===== -->
    <right>
        <VBox prefWidth="220.0" spacing="8.0" styleClass="profbug-panel">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label styleClass="profbug-title" text="Prof.Bug" />
            <Separator />

            <ListView fx:id="chatHistoryList" styleClass="chat-history" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <TextField fx:id="chatInputField" promptText="Ask Prof.Bug..." HBox.hgrow="ALWAYS" />
                <Button fx:id="chatSendButton" mnemonicParsing="false" text="Send" />
            </HBox>
        </VBox>
    </right>

</BorderPane>
